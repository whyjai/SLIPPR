NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
CRON_SECRET=your_super_secret_32char_string
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional
DAILY_EMAIL_RECIPIENTS=you@example.com
ODDS_API_KEY=

# --- Real data pipeline ---
# the-odds-api.com (free tier: 500 credits/mo = 2 scans/day; paid unlocks SCAN_HOURS=3)
# ODDS_API_KEY=

# openrouter.ai — one key reaches all 10 free council models.
# Park a one-time $10 credit on the account to unlock 1,000 free-model calls/day.
# OPENROUTER_API_KEY=

# Optional overrides
# SCAN_HOURS=12            # odds scan cadence; set 3 on a paid odds key
# COUNCIL_MODELS=          # comma-separated OpenRouter model ids (max 10)
# SCOUT_MODEL=google/gemini-2.5-flash   # research agent before council
# TAVILY_API_KEY=          # optional live injury/lineup context for Scout

# --- Prop Edges (DFS pick'em + Fliff moneyline/total vs sharp books) ---
# Every event's request bills ~1 credit per market. Player-prop markets run
# 4-5/event; Fliff's moneyline + game total (h2h,totals) add 2 more, bundled
# into the same request — so each event now costs ~6-7 credits, not ~5.
# 8 games × 2 scans/day × ~6.5 credits ≈ 3,100 credits/mo — needs a paid Odds
# API plan. (Measured live on 2026-09-24: 20 events cost 131 credits with
# game lines on vs ~84 without — budget PROPS_MAX_EVENTS accordingly.)
# PROP_SCAN=on
# PROPS_MAX_EVENTS=8       # games scanned per run (soonest first)
# PROPS_SCAN_HOURS=12      # scan cadence; 3 = every cron run
# PROPS_EXTRA_BOOKS=       # e.g. dabble,sleeper if your plan carries them
# Without PROP_SCAN (or when credits run out) Prop Edges falls back to Pinnacle's
# free public feed: sharp prices only, app lines shown as "verify line" — and
# no moneyline/total coverage, since Pinnacle's guest feed only has props.
#
# Moneyline + game total: Fliff-only (it's the one target app that's a real
# sportsbook — PrizePicks/Underdog/Pick6/Betr don't carry these markets at
# all). These are priced far tighter than player props in practice — a live
# check tonight found zero edges on an NFL game because Fliff's price tracked
# the sharp consensus within a point. Don't expect these often; when Prop
# Edges shows one, it cleared the same 3%+ bar as everything else.

# Daily promo graphic: GET /api/og/daily-slip?key=<PROMO_GRAPHIC_KEY> (1080x1350 PNG).
# Required in production (it shows the full slip); open in local dev when unset.
# PROMO_GRAPHIC_KEY=

# --- Stale Line Alerts ---
# Pinnacle updates player props faster than pick'em apps do. This watches for
# a Pinnacle move the apps haven't followed yet — the app's OLD price is the
# stale line. Free to run (Pinnacle's guest feed); only spends an Odds API
# request when a game+market actually moves, capped at STALE_LINE_BUDGET/day.
# STALE_LINE_SCAN=on
# STALE_LINE_BUDGET=60     # max Odds API requests/day for this scan
#
# IMPORTANT — cadence: vercel.json points /api/cron/stale-lines at */5 min,
# but Vercel Cron on the Hobby plan is capped to ~once/day regardless of what
# the schedule says, which defeats the purpose (a stale line is usually gone
# in minutes). On Hobby, point an external scheduler (cron-job.org, QStash,
# a GitHub Actions workflow_dispatch on a timer) at this URL instead:
#   GET https://<your-app>/api/cron/stale-lines
#   Authorization: Bearer <CRON_SECRET>

# --- Payments (Stripe) ---
# STRIPE_SECRET_KEY=sk_live_or_test_...
# STRIPE_PRICE_ID=price_...          # the recurring Pro price
# STRIPE_WEBHOOK_SECRET=whsec_...    # from `stripe listen` or the dashboard webhook
